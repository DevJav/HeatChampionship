# SQLite database file (relative to the project root)
DATABASE_URL="file:./data/heat.db"

# Where uploaded race photos are stored (default: ./data/uploads)
# UPLOAD_DIR="./data/uploads"

# Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public URL of the site (your Cloudflare tunnel hostname in production)
BETTER_AUTH_URL="http://localhost:3000"

# Admin account created by `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"

# Public address used in WhatsApp messages, calendar invites and link previews.
# Defaults to BETTER_AUTH_URL, which must be the public URL anyway.
# SITE_URL="https://heat.example.com"
