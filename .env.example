# SQLite database file (relative to the project root)
DATABASE_URL="file:./data/heat.db"

# Where uploaded race photos are stored (default: ./data/uploads)
# UPLOAD_DIR="./data/uploads"

# Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public URL of the site (your Cloudflare tunnel hostname in production)
BETTER_AUTH_URL="http://localhost:3000"

# Admin account created by `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"

# Public address used in WhatsApp messages, calendar invites and link previews.
# Defaults to BETTER_AUTH_URL, which must be the public URL anyway.
# SITE_URL="https://heat.example.com"

# Site language, "es" (default) or "en". Read at build time: rebuild after changing it.
# APP_LOCALE="es"
# Time zone race times are entered and shown in (default: Europe/Madrid). Also build time.
# APP_TIME_ZONE="Europe/Madrid"

# Optional emails (new races, results, news) through Resend: https://resend.com
# Without RESEND_API_KEY emails are off and the profile doesn't ask for an address.
# RESEND_API_KEY="re_..."
# Sender, from a domain verified in Resend. The default (onboarding@resend.dev) only reaches your own Resend account.
# EMAIL_FROM="Heat Championship <heat@example.com>"
# Where replies go (optional)
# EMAIL_REPLY_TO="you@example.com"

# Nightly back-ups (npm run backup, scheduled by pm2). Archives go to BACKUP_DIR (default: ./backups)
# and, if set, are uploaded to this rclone remote. See docs/setup.md#back-ups.
# BACKUP_REMOTE="gdrive:heat-backups"
# BACKUP_DIR="./backups"
# BACKUP_KEEP_DAYS=14
