// Heat Championship database schema.
// Database URL lives in prisma.config.ts (from DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth — tables required by Better Auth (core + username + admin plugins).
// Field names must match what Better Auth expects; extra columns are ours.
// ---------------------------------------------------------------------------

model User {
  id              String    @id
  /// Display name shown across the site
  name            String
  /// Internal placeholder (<username>@users.heat.local); players log in by username
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?   @unique
  displayUsername String?
  /// "admin" or "user"
  role            String?
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?

  // Championship profile
  bio             String?
  favoriteColorId String?
  favoriteColor   CarColor? @relation(fields: [favoriteColorId], references: [id], onDelete: SetNull)

  // Optional emails (see src/lib/email). `email` above is a placeholder, so the real address lives here.
  contactEmail    String?
  /// Comma-separated email topics the driver wants, e.g. "races,news" (see src/lib/email/topics.ts)
  emailTopics     String    @default("")
  /// Secret for the unsubscribe link in every email, so it works without logging in
  emailToken      String?   @unique
  /// When they answered the "add your email?" banner (added it or said not now); it isn't shown again
  emailPromptDismissedAt DateTime?

  sessions      Session[]
  accounts      Account[]
  registrations Registration[]
  results       RaceResult[]
  photos        RacePhoto[]
  articles      Article[]
  comments      ArticleComment[]
  notifications Notification[]   @relation("NotificationsReceived")
  /// Notifications caused by this user (their mention, reply…)
  notified      Notification[]   @relation("NotificationsCaused")
  activity      Activity[]
  dotdVotesCast     DriverOfTheDayVote[] @relation("DotdVotesCast")
  dotdVotesReceived DriverOfTheDayVote[] @relation("DotdVotesReceived")
  predictions       Prediction[]         @relation("PredictionsMade")
  pickedFirst       Prediction[]         @relation("PickedFirst")
  pickedSecond      Prediction[]         @relation("PickedSecond")
  pickedThird       Prediction[]         @relation("PickedThird")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// App settings — a single row (id = 1)
// ---------------------------------------------------------------------------

model AppSettings {
  id               Int     @id @default(1)
  /// When false, new accounts can't be created from the sign-up page
  registrationOpen Boolean @default(true)
}

// ---------------------------------------------------------------------------
// Catalogs — editable from the admin so expansions only need new rows
// ---------------------------------------------------------------------------

model Track {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// ISO 3166-1 alpha-2 code, e.g. "IT"; drives the flag and the country name
  countryCode String?
  /// Base game or expansion name, e.g. "Juego base", "Heavy Rain"
  expansion   String?
  defaultLaps Int?
  imageUrl    String?
  description String?
  active      Boolean @default(true)

  races Race[]
}

model CarColor {
  id        String  @id @default(cuid())
  name      String  @unique
  /// CSS color, e.g. "#d10500"
  hex       String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  results  RaceResult[]
  favorers User[]
}

model Upgrade {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  expansion   String?
  active      Boolean @default(true)

  results ResultUpgrade[]
}

// ---------------------------------------------------------------------------
// Championship
// ---------------------------------------------------------------------------

enum SeasonStatus {
  UPCOMING
  ACTIVE
  FINISHED
}

model Season {
  id          String       @id @default(cuid())
  name        String
  year        Int
  status      SeasonStatus @default(UPCOMING)
  /// Points by finishing position: [9, 6, 4, 3, 2, 1] → 1st gets 9, 6th gets 1
  pointsTable Json
  createdAt   DateTime     @default(now())

  races    Race[]
  activity Activity[]
}

enum RaceStatus {
  /// Being prepared, not visible to players
  DRAFT
  /// Announced on the calendar, sign-ups not open yet
  UPCOMING
  /// Sign-ups open
  OPEN
  /// Sign-ups closed, waiting to be raced
  CLOSED
  /// Results recorded and points awarded
  FINISHED
}

model Race {
  id             String     @id @default(cuid())
  seasonId       String
  trackId        String
  round          Int
  scheduledAt    DateTime
  location       String?
  laps           Int?
  maxPlayers     Int        @default(8)
  signupDeadline DateTime?
  status         RaceStatus @default(DRAFT)
  notes          String?
  finalizedAt    DateTime?
  /// When the Driver of the Day result was announced (or the closed vote was checked), so it happens once
  dotdAnnouncedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  season        Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  track         Track          @relation(fields: [trackId], references: [id])
  registrations Registration[]
  results       RaceResult[]
  photos        RacePhoto[]
  log           RaceLog?
  dotdVotes     DriverOfTheDayVote[]
  predictions   Prediction[]
  articles      Article[]
  notifications Notification[]
  activity      Activity[]

  @@unique([seasonId, round])
  @@index([scheduledAt])
}

enum RegistrationStatus {
  CONFIRMED
  WAITLIST
  WITHDRAWN
}

model Registration {
  id        String             @id @default(cuid())
  raceId    String
  userId    String
  status    RegistrationStatus @default(CONFIRMED)
  /// Place in the queue: seats go to the earliest; reset when re-joining after withdrawing
  queuedAt  DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raceId, userId])
}

model RaceResult {
  id            String   @id @default(cuid())
  raceId        String
  userId        String
  /// Finishing position — in Heat everyone finishes the race
  position      Int
  /// Spin-outs (trompos) during the race, a fun statistic
  spins         Int      @default(0)
  startPosition Int?
  carColorId    String?
  /// Snapshot of points awarded when the race was finalized
  points        Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  race     Race            @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  carColor CarColor?       @relation(fields: [carColorId], references: [id], onDelete: SetNull)
  upgrades ResultUpgrade[]

  @@unique([raceId, userId])
  @@index([userId])
}

model ResultUpgrade {
  resultId  String
  upgradeId String

  result  RaceResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  upgrade Upgrade    @relation(fields: [upgradeId], references: [id], onDelete: Cascade)

  @@id([resultId, upgradeId])
}

/// Round-by-round record of a race: where every car ended each round
model RaceLog {
  raceId    String   @id
  /// RaceLogData (src/lib/race-log/log.ts): cars in grid order, closed rounds and the round being entered
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
}

/// One driver's Driver of the Day vote in a race (see src/lib/driver-of-the-day.ts). They can change it while voting is open.
model DriverOfTheDayVote {
  raceId    String
  voterId   String
  driverId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  race   Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  voter  User @relation("DotdVotesCast", fields: [voterId], references: [id], onDelete: Cascade)
  driver User @relation("DotdVotesReceived", fields: [driverId], references: [id], onDelete: Cascade)

  @@id([raceId, voterId])
}

/// Someone's podium prediction for a race (see src/lib/predictions.ts). Editable until the race starts.
model Prediction {
  raceId    String
  userId    String
  firstId   String
  secondId  String
  thirdId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  race   Race @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user   User @relation("PredictionsMade", fields: [userId], references: [id], onDelete: Cascade)
  first  User @relation("PickedFirst", fields: [firstId], references: [id], onDelete: Cascade)
  second User @relation("PickedSecond", fields: [secondId], references: [id], onDelete: Cascade)
  third  User @relation("PickedThird", fields: [thirdId], references: [id], onDelete: Cascade)

  @@id([raceId, userId])
}

model RacePhoto {
  id           String   @id @default(cuid())
  raceId       String
  /// Path relative to the uploads directory
  path         String
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  race       Race  @relation(fields: [raceId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// News — articles written by admins
// ---------------------------------------------------------------------------

enum ArticleCategory {
  /// Before a race
  PREVIEW
  /// After a race
  REPORT
  /// Championship news and updates
  NEWS
  /// Rules and how the championship works
  RULES
}

enum ArticleStatus {
  /// Being written, only admins see it
  DRAFT
  PUBLISHED
}

model Article {
  id          String          @id @default(cuid())
  /// URL name, from the title; frozen once published so links keep working
  slug        String          @unique
  title       String
  /// Summary shown in lists and link previews
  excerpt     String?
  /// Banner image, path relative to the uploads directory; the race's flag is used without one
  coverImage  String?
  /// Markdown, with @username mentions and {{embed:id}} blocks (see src/lib/articles.ts)
  body        String
  category    ArticleCategory @default(NEWS)
  status      ArticleStatus   @default(DRAFT)
  /// Featured at the top of the news page
  pinned      Boolean         @default(false)
  /// The race it's about: listed on that race's page
  raceId      String?
  authorId    String?
  /// Set the first time it's published
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  race          Race?            @relation(fields: [raceId], references: [id], onDelete: SetNull)
  author        User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments      ArticleComment[]
  notifications Notification[]

  @@index([status, publishedAt])
  @@index([raceId])
}

/// Drivers' comments under an article, oldest first. Replies are one level deep.
model ArticleComment {
  id        String   @id @default(cuid())
  articleId String
  authorId  String
  /// The top-level comment this replies to (replies to a reply join the same thread)
  parentId  String?
  /// Light Markdown (bold, italics, links) with @username mentions
  body      String
  createdAt DateTime @default(now())

  article       Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        ArticleComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ArticleComment[] @relation("Replies")
  notifications Notification[]

  @@index([articleId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications — the header bell
// ---------------------------------------------------------------------------

enum NotificationType {
  /// Mentioned (or given a driver card) in a published article
  ARTICLE_MENTION
  /// Mentioned in a comment
  COMMENT_MENTION
  /// Someone replied to your comment
  COMMENT_REPLY
  /// A race you drove has results
  RACE_RESULTS
  /// The Driver of the Day vote of a race you drove has closed; the actor is the winner
  DRIVER_OF_THE_DAY
}

/// The text is built when shown, from the linked article, comment or race
model Notification {
  id        String           @id @default(cuid())
  /// Who receives it
  userId    String
  type      NotificationType
  /// Who caused it, if anyone (the race results have no actor)
  actorId   String?
  articleId String?
  commentId String?
  raceId    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User            @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?           @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: SetNull)
  article Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment ArticleComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  race    Race?           @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Activity — the league's public feed (home page and /actividad)
// ---------------------------------------------------------------------------

enum ActivityType {
  /// A new driver signed up to the site
  PLAYER_JOINED
  /// A race appeared on the calendar (published without sign-ups yet)
  RACE_ANNOUNCED
  /// Sign-ups opened for a race
  SIGNUPS_OPENED
  /// A driver signed up for a race (seat or waitlist)
  RACE_SIGNUP
  /// A driver withdrew from a race
  RACE_WITHDRAWAL
  /// A race's results were published
  RESULTS_PUBLISHED
  /// A driver added photos to a race
  PHOTOS_ADDED
  SEASON_STARTED
  SEASON_FINISHED
  /// A driver was voted Driver of the Day (the actor)
  DRIVER_OF_THE_DAY
}

/** One line in the feed. The text is built when shown, from the linked driver, race or season (see src/lib/activity.ts). */
model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  /// The driver it's about, if any
  actorId   String?
  raceId    String?
  seasonId  String?
  createdAt DateTime     @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  race   Race?   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([raceId, type])
}

// ---------------------------------------------------------------------------
// Emails — one row per email sent to subscribers, so re-saving never sends twice
// ---------------------------------------------------------------------------

model EmailBroadcast {
  id         String   @id @default(cuid())
  /// What it was about, e.g. "race-open:<raceId>" or "article:<articleId>"
  key        String   @unique
  recipients Int      @default(0)
  sentAt     DateTime @default(now())
}
